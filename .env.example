# =============================================================================
# RememberMe Bot - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# Isolates Docker containers, network, and volumes from other bots/services.
COMPOSE_PROJECT_NAME=telegram_productivity_bot

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
# Get token from @BotFather on Telegram
BOT_TOKEN=replace-with-bot-token
# Optional: bot username without @, used to render share links
BOT_USERNAME=your_bot_username

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=rememberme
POSTGRES_PORT=5432
# Bind PostgreSQL to localhost only. Do not expose it publicly on VPS.
POSTGRES_BIND_HOST=127.0.0.1
# Default local PostgreSQL port is 5432.
# If another local PostgreSQL already uses 5432, set POSTGRES_PORT=5433
# and update DATABASE_URL to use localhost:5433.

# Database connection URL (for app)
# Format: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your-secure-password-here@localhost:5432/rememberme

# Enable SQL query logging (debug only)
DB_ECHO=false

# -----------------------------------------------------------------------------
# Admin API
# -----------------------------------------------------------------------------
# Secret token for admin API authentication
ADMIN_TOKEN=your-super-secret-admin-token-here
# Comma-separated Telegram IDs that should be marked as bot admins.
# You can get your Telegram ID from bots like @userinfobot.
ADMIN_TELEGRAM_IDS=123456789

# API server settings.
# Local/dev can use API_HOST=0.0.0.0 inside Docker.
# Production/VPS recommendation: keep API_BIND_HOST=127.0.0.1 and do not expose
# docs or broad CORS unless the API is behind HTTPS/proxy/firewall.
API_HOST=0.0.0.0
API_PORT=8000
# Host interface exposed by Docker Compose.
# Keep 127.0.0.1 on VPS unless you put the API behind HTTPS/proxy/firewall.
API_BIND_HOST=127.0.0.1
# Local debugging: API_DOCS_ENABLED=true, CORS_ORIGINS=*
# Production/VPS: API_DOCS_ENABLED=false, CORS_ORIGINS=
API_DOCS_ENABLED=false
# Comma-separated origins. Use * only for local development.
CORS_ORIGINS=
# Telegram WebApp user API auth max age in seconds.
USER_AUTH_MAX_AGE_SECONDS=86400
# Test web UI can authenticate a browser user with ADMIN_TOKEN + Telegram ID.
# Keep true while the project is in private testing; disable for public production.
WEB_TEST_LOGIN_ENABLED=true
# Public base URL used in Telegram-issued web login links.
# Local example: http://127.0.0.1:8000
# Production example: https://bot.example.com
WEB_PUBLIC_URL=
# Personal web keys issued by the bot stay active for this many days.
WEB_LOGIN_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Default timezone for new users
TIMEZONE_DEFAULT=Europe/Moscow

# Version/changelog shown in restart notification
APP_VERSION=0.1.0-beta
APP_RELEASE_CHANNEL=beta
APP_GITHUB_URL=https://github.com/NikitaZhilin/a-new-telegram-bot-with-extensive-functionality
APP_CHANGELOG_URL=https://github.com/NikitaZhilin/a-new-telegram-bot-with-extensive-functionality/releases
STARTUP_UPDATE_MESSAGE=Бета-обновление: улучшена стабильность и web-версия.
# Optional ASCII-safe UTF-8/base64 changelog for SSH/CI deploys.
# If set, it overrides STARTUP_UPDATE_MESSAGE.
STARTUP_UPDATE_MESSAGE_B64=
# Admin-facing technical changelog. Keep user-facing text in STARTUP_UPDATE_MESSAGE.
STARTUP_TECHNICAL_MESSAGE=
STARTUP_TECHNICAL_MESSAGE_B64=
TESTING_NOTICE_ENABLED=true
TESTING_NOTICE_TEXT=⚠️ Бот находится в тестировании. Данные могут быть изменены или утеряны.

# Voice-to-list transcription. Disabled until OPENAI_API_KEY is configured.
VOICE_LIST_INPUT_ENABLED=false
VOICE_TRANSCRIPTION_ENABLED=false
OPENAI_API_KEY=
VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_TRANSCRIPTION_FALLBACK_MODELS=whisper-1
VOICE_TRANSCRIPTION_LANGUAGE=ru
VOICE_MAX_DURATION_SECONDS=180
VOICE_MAX_FILE_MB=20
VOICE_LIST_MAX_ITEMS=40

# Startup announcements are off by default to avoid noisy release messages.
# Use STARTUP_ANNOUNCE_MODE=major and STARTUP_ANNOUNCE_IMPORTANCE=major|critical only for important releases.
SEND_STARTUP_MENU_ON_BOOT=true
STARTUP_ANNOUNCE_MODE=off
STARTUP_ANNOUNCE_IMPORTANCE=minor
# Admin-only startup notice: off, once_per_version, or always.
STARTUP_ADMIN_ANNOUNCE_MODE=once_per_version

# Default monetization plan for new users. Keep "free" during public beta/debug.
DEFAULT_SUBSCRIPTION_PLAN=free

# Worker check interval (seconds)
WORKER_INTERVAL=60
# Runtime heartbeat interval for api, bot, and worker.
SERVICE_HEARTBEAT_INTERVAL_SECONDS=45

# -----------------------------------------------------------------------------
# Webhook (optional, for production)
# -----------------------------------------------------------------------------
# Set if using webhook instead of polling
# WEBHOOK_URL=https://your-domain.com/webhook
# APP_BASE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Docker Compose (local development)
# -----------------------------------------------------------------------------
# These are used by docker-compose.yml.
# docker-compose up -d runs postgres, init-db, api, bot, and worker.
# Polling bot and worker must stay single-instance with one Telegram token.
# API_PORT=8000
# POSTGRES_PORT=5432
# POSTGRES_PORT=5433  # optional local fallback if 5432 is busy
