# Production environment example.
# Copy this file to .env.prod locally or create it from GitHub Secrets during CI.
# Do not commit real tokens, passwords, server addresses, or private keys.

COMPOSE_PROJECT_NAME=rememberme_bot
APP_IMAGE=rememberme_bot-app:latest
WORKER_IMAGE=rememberme_bot-worker:latest

# Telegram Bot
BOT_TOKEN=replace-with-prod-bot-token
BOT_USERNAME=your_bot_username

# PostgreSQL. The database data is stored in Docker volume:
# rememberme_bot_postgres_data when COMPOSE_PROJECT_NAME=rememberme_bot.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=rememberme
POSTGRES_PORT=5432
POSTGRES_BIND_HOST=127.0.0.1
DB_ECHO=false

# Admin API
ADMIN_TOKEN=replace-with-strong-admin-token
ADMIN_TELEGRAM_IDS=123456789
API_HOST=0.0.0.0
API_PORT=8000
API_BIND_HOST=127.0.0.1
API_DOCS_ENABLED=false
CORS_ORIGINS=
USER_AUTH_MAX_AGE_SECONDS=86400
WEB_TEST_LOGIN_ENABLED=false
WEB_PUBLIC_URL=
WEB_LOGIN_TOKEN_TTL_DAYS=30
MINI_APP_MENU_BUTTON_TEXT=RememberMe

# Application
LOG_LEVEL=INFO
TIMEZONE_DEFAULT=Europe/Moscow
APP_VERSION=0.1.0-beta
APP_RELEASE_CHANNEL=beta
APP_GITHUB_URL=https://github.com/NikitaZhilin/a-new-telegram-bot-with-extensive-functionality
APP_CHANGELOG_URL=https://github.com/NikitaZhilin/a-new-telegram-bot-with-extensive-functionality/releases
STARTUP_UPDATE_MESSAGE=Обновлена стабильность сервиса и web-версии.
# Optional ASCII-safe UTF-8/base64 changelog for SSH/CI deploys.
# If set, it overrides STARTUP_UPDATE_MESSAGE.
STARTUP_UPDATE_MESSAGE_B64=
STARTUP_TECHNICAL_MESSAGE=
STARTUP_TECHNICAL_MESSAGE_B64=
TESTING_NOTICE_ENABLED=true
TESTING_NOTICE_TEXT=⚠️ Бот находится в тестировании. Данные могут быть изменены или утеряны.
SEND_STARTUP_MENU_ON_BOOT=true
STARTUP_ANNOUNCE_MODE=off
STARTUP_ANNOUNCE_IMPORTANCE=minor
STARTUP_ADMIN_ANNOUNCE_MODE=once_per_version
DEFAULT_SUBSCRIPTION_PLAN=free
WORKER_INTERVAL=60
SERVICE_HEARTBEAT_INTERVAL_SECONDS=45
# Optional. Keep empty until a local RememberMe supervisor consumes queued JSON restart requests.
RESTART_REQUEST_DIR=
